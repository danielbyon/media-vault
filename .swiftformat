# SwiftFormat 0.63.0. The exact tool version is pinned in Mintfile.
# Rules are disabled globally and explicitly opted in below.

--swift-version 6.4
--exclude .build,**/.build/**,**/.swiftpm/**,**/Generated/**,**/*.generated.swift

--disable all

# Canonical whitespace and layout.
--enable braces,consecutiveBlankLines,consecutiveSpaces,elseOnSameLine,emptyBraces,indent,leadingDelimiters,linebreakAtEndOfFile,linebreaks,modifierOrder,modifiersOnSameLine,semicolons,spaceAroundBraces,spaceAroundBrackets,spaceAroundComments,spaceAroundGenerics,spaceAroundOperators,spaceAroundParens,spaceInsideBraces,spaceInsideBrackets,spaceInsideComments,spaceInsideGenerics,spaceInsideParens,trailingCommas,trailingSpace,wrap,wrapArguments,wrapAttributes,wrapCaseBodies,wrapEnumCases,wrapFunctionBodies,wrapGuardStatementBodies,wrapIfExpressionBodies,wrapIfStatementBodies,wrapLoopBodies,wrapMultilineConditionalAssignment,wrapMultilineFunctionChains,wrapPropertyBodies,wrapSwitchCases

# Blank-line policy.
--enable blankLineAfterImports,blankLinesAfterGuardStatements,blankLinesAroundMark,blankLinesAtEndOfScope,blankLinesAtStartOfScope,blankLinesBetweenChainedFunctions,blankLinesBetweenImports,blankLinesBetweenScopes

# Imports, headers, comments, and declarations.
--enable docComments,docCommentsBeforeModifiers,duplicateImports,emptyExtensions,fileHeader,headerFileName,sortImports,todos

# Safe and explicitly approved language modernization.
--enable acronyms,andOperator,anyObjectProtocol,applicationMain,assertionFailures,conditionalAssignment,enumNamespaces,environmentEntry,extensionAccessControl,fileMacro,genericExtensions,hoistAwait,hoistPatternLet,hoistTry,initCoderUnavailable,isEmpty,numberFormatting,opaqueGenericParameters,preferContains,preferCountWhere,preferFirstWhere,preferFlatMap,preferKeyPath,preferLazyMap,preferMinOverSorted,preferSwiftStringAPI,privateStateVariables,simplifyGenericConstraints,singlePropertyPerLine,sortTypealiases,strongOutlets,strongifiedSelf,trailingClosures,typeSugar,unusedArguments,void,yodaConditions

# Redundancy cleanup.
--enable redundantAsync,redundantBackticks,redundantBreak,redundantClosure,redundantEmptyView,redundantEquatable,redundantExtendedLifetime,redundantExtensionACL,redundantFileprivate,redundantGet,redundantInit,redundantInternal,redundantLet,redundantLetError,redundantMemberwiseInit,redundantNilInit,redundantObjc,redundantOptionalBinding,redundantParens,redundantPattern,redundantPublic,redundantRawValues,redundantReturn,redundantSelf,redundantStaticSelf,redundantSwiftTestingSuite,redundantSwiftUIGroup,redundantThrows,redundantType,redundantTypedThrows,redundantVariable,redundantViewBuilder,redundantVoidReturnType

# Test-source normalization.
--enable noForceTryInTests,noForceUnwrapInTests,noGuardInTests,testSuiteAccessControl,validateTestCases

# Indentation and line endings.
--indent 4 # default
--tab-width 4
--smart-tabs enabled # default
--indent-case false # default
--ifdef no-indent
--xcode-indentation disabled # default
--indent-strings false # default
--indent-blank-lines false # default
--linebreaks lf # default
--trim-whitespace always # default

# Braces and control-flow placement.
--allman false # default
--else-position same-line # default
--guard-else auto # default
--empty-braces no-space # default
--semicolons never
--operator-func spaced # default
--ranges spaced # default
--type-delimiter space-after # default
--no-space-operators # default

# Width and wrapping. 120 is the formatter target; SwiftLint owns the 140 hard ceiling.
--max-width 120
--list-wrap-threshold none # default
--wrap-arguments before-first
--wrap-parameters before-first
--wrap-collections before-first
--wrap-conditions after-first
--wrap-type-aliases before-first
--wrap-return-type never
--wrap-effects never
--closing-paren balanced # default
--call-site-paren balanced
--wrap-ternary before-operators
--wrap-string-interpolation false # default
--allow-partial-wrapping false
--no-wrap-operators # default
--asset-literals visual-width # default
--wrap-enum-cases always # default

# Attributes are always placed on their own line.
--func-attributes prev-line
--type-attributes prev-line
--var-attributes prev-line
--stored-var-attributes prev-line
--computed-var-attributes prev-line
--complex-attributes prev-line
--non-complex-attributes # default

# Imports remain one contiguous block; @testable imports follow ordinary imports.
--import-grouping alpha,testable-last

# File header. SwiftFormat supplies the // comment markers for the header template.
--header "\n {file}\n MediaVault\n\n SPDX-License-Identifier: GPL-3.0-or-later\n"
--date-format system # default
--timezone system # default

# Documentation and declaration details.
--doc-comments before-non-local-declarations
--extension-acl on-declarations
--enum-namespaces always # default
--file-macro "#fileID"
--init-coder-nil false # default
--conditional-assignment after-property # default
--pattern-let hoist # default
--self remove # default
--self-required # default

# Modifier order is SwiftFormat 0.63.0's upstream default, written explicitly.
--modifier-order override,private,fileprivate,internal,package,public,open,private(set),fileprivate(set),internal(set),package(set),public(set),open(set),final,dynamic,optional,required,convenience,indirect,isolated,nonisolated,nonisolated(unsafe),lazy,weak,unowned,unowned(safe),unowned(unsafe),static,class,borrowing,consuming,mutating,nonmutating,prefix,infix,postfix,async # default

# Blank-line details.
--type-blank-lines remove # default
--line-after-marks true # default
--line-between-guards false # default

# Numeric literals: group every integer base by three beginning at four digits.
--decimal-grouping 3,4
--binary-grouping 3,4
--octal-grouping 3,4
--hex-grouping 3,4
--fraction-grouping disabled # default
--exponent-grouping disabled # default
--hex-literal-case lowercase
--exponent-case lowercase # default

# Redundancy and test policy.
--property-types inferred
--redundant-async tests-only # default
--redundant-throws tests-only # default
--redundant-optional-binding same-name-only # default
--prefer-synthesized-init-for-internal-structs never # default
--guard-like-if-statements preserve # default
--void-type Void # default
--closure-void remove # default
--short-optionals preserve-struct-inits # default
--strip-unused-args always # default
--trailing-commas always # default
--test-case-name-format raw-identifiers # default
--suite-name-format standard-identifiers
--test-case-access-control internal # default
--nil-init remove # default
--yoda-swap always # default

# SwiftFormat 0.63.0 accepts a bare set option as an explicit empty set.
--acronyms ID,URL,UUID # default
--preserve-acronyms # default
--generic-types # default
--some-any true # default
--equatable-macro none # default
--throw-capturing # default
--async-capturing # default
--trailing-closures # default
--never-trailing # default
